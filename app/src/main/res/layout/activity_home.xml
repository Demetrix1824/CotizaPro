<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- CONTENIDO PRINCIPAL -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- BARRA SUPERIOR -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:background="@color/surface"
            android:elevation="3dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="15dp"
            android:paddingEnd="20dp">

            <TextView
                android:id="@+id/btnMenu"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:gravity="center"
                android:text="☰"
                android:textColor="@color/primary"
                android:textSize="28sp"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Abrir menú lateral" />

            <ImageView
                android:layout_width="43dp"
                android:layout_height="43dp"
                android:layout_marginStart="8dp"
                android:src="@drawable/logo_cotizapro"
                android:scaleType="fitCenter"
                android:contentDescription="Logo CotizaPro" />


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="CotizaPro"
                android:textColor="@color/text_primary"
                android:textSize="21sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- CONTENIDO DE HOME -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center_vertical"
                android:padding="20dp">

                <!-- BIENVENIDA -->
                <LinearLayout
                    android:id="@+id/id_bienvenida"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_bienvenida"
                    android:orientation="vertical"
                    android:padding="23dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="¡Bienvenido!"
                        android:textColor="#FFFFFF"
                        android:textSize="25sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Administra tus cotizaciones de manera rápida y sencilla."
                        android:textColor="#EAF4FF"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvUsuarioHome"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="15dp"
                        android:text="Usuario"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp" />

                </LinearLayout>

                <!-- TITULO -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="30dp"
                    android:layout_marginBottom="15dp"
                    android:text="Accesos rápidos"
                    android:textColor="#173B5E"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <!-- PRIMERA FILA -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/cardNuevaCotizacion"
                        android:layout_width="0dp"
                        android:layout_height="145dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_card"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="＋"
                            android:textColor="#1769AA"
                            android:textSize="35sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Nueva cotización"
                            android:textColor="#173B5E"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Crear presupuesto"
                            android:textColor="#718096"
                            android:textSize="11sp" />

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/cardClientes"
                        android:layout_width="0dp"
                        android:layout_height="145dp"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_card"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="♙"
                            android:textColor="#1769AA"
                            android:textSize="35sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Clientes"
                            android:textColor="#173B5E"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Administrar clientes"
                            android:textColor="#718096"
                            android:textSize="11sp" />

                    </LinearLayout>

                </LinearLayout>

                <!-- SEGUNDA FILA -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/cardProductos"
                        android:layout_width="0dp"
                        android:layout_height="145dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_card"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="▣"
                            android:textColor="#1769AA"
                            android:textSize="35sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Productos"
                            android:textColor="#173B5E"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Consultar productos"
                            android:textColor="#718096"
                            android:textSize="11sp" />

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/cardHistorial"
                        android:layout_width="0dp"
                        android:layout_height="145dp"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_card"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="◷"
                            android:textColor="#1769AA"
                            android:textSize="35sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Historial"
                            android:textColor="#173B5E"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Ver cotizaciones"
                            android:textColor="#718096"
                            android:textSize="11sp" />

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

        </ScrollView>

    </LinearLayout>

    <!-- BARRA LATERAL -->
    <LinearLayout
        android:layout_width="285dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/surface"
        android:elevation="12dp"
        android:orientation="vertical">

        <!-- ENCABEZADO DEL MENU -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="165dp"
            android:background="#1769AA"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:padding="22dp">

            <ImageView
                android:layout_width="65dp"
                android:layout_height="65dp"
                android:src="@drawable/logo_cotizapro"
                android:scaleType="fitCenter"
                android:contentDescription="Logo CotizaPro" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="CotizaPro"
                android:textColor="#FFFFFF"
                android:textSize="23sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Menú de navegación"
                android:textColor="#EAF4FF"
                android:textSize="12sp" />

        </LinearLayout>

        <!-- OPCIONES DEL MENU -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:gravity="center_vertical"
            android:paddingStart="22dp"
            android:text="GENERAL"
            android:textColor="#9AA8B7"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/navInicio"
            style="@style/MenuItem"
            android:text="⌂    Inicio" />

        <TextView
            android:id="@+id/navNuevaCotizacion"
            style="@style/MenuItem"
            android:text="＋    Nueva cotización" />

        <TextView
            android:id="@+id/navClientes"
            style="@style/MenuItem"
            android:text="♙    Clientes" />

        <TextView
            android:id="@+id/navProductos"
            style="@style/MenuItem"
            android:text="▣    Productos" />

        <TextView
            android:id="@+id/navHistorial"
            style="@style/MenuItem"
            android:text="◷    Historial de cotizaciones" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:gravity="center_vertical"
            android:paddingStart="22dp"
            android:text="OTROS"
            android:textColor="#9AA8B7"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/navConfiguracion"
            style="@style/MenuItem"
            android:text="⚙    Configuración" />

        <TextView
            android:id="@+id/navAyuda"
            style="@style/MenuItem"
            android:text="Ayuda" />

        <!-- ESPACIO FLEXIBLE -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- CERRAR SESION -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginHorizontal="18dp"
            android:background="#E7EDF4" />

        <TextView
            android:id="@+id/navCerrarSesion"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:gravity="center_vertical"
            android:paddingStart="22dp"
            android:text="⇦    Cerrar sesión"
            android:textColor="#D64545"
            android:textSize="15sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground" />

    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>